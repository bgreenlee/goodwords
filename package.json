{
  "name": "goodwords",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "data": "python3 tools/build_data.py",
    "test": "vitest run --no-file-parallelism src/game tools/browser.test.ts tools/onboarding.test.ts tools/room.test.ts tools/multiplayer.test.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "analyze": "vitest run tools/analyze.test.ts",
    "floor": "vitest run tools/floor.test.ts",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "dev:api": "wrangler dev --port 8787",
    "preview:full": "npm run build && wrangler dev --port 8788",
    "test:boundary": "vitest run tools/boundary.test.ts",
    "smoke": "vitest run tools/smoke.test.ts",
    "live": "vitest run tools/live.test.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5",
    "wrangler": "^4.127.1"
  }
}
